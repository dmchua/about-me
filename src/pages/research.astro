---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import SwallowFigure from '../components/SwallowFigure.astro';

const page = (await getEntry('pages', 'research'))!;

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || b.data.order - a.data.order || a.data.title.localeCompare(b.data.title),
);
const groups = [
  { type: 'article', heading: 'Selected peer-reviewed articles' },
  { type: 'conference', heading: 'Selected conference papers' },
  { type: 'unpublished', heading: 'Unpublished work' },
] as const;
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <SwallowFigure />
  <h1>{page.data.title}</h1>
  <div class="publications">
    {groups.map((g) => {
      const items = pubs.filter((p) => p.data.type === g.type);
      return items.length > 0 && (
        <section>
          <h2>{g.heading}</h2>
          <ol class="pub-list">
            {items.map((p) => <Publication pub={p} />)}
          </ol>
        </section>
      );
    })}
  </div>
</BaseLayout>
