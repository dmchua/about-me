---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import HeroSwallow from '../components/HeroSwallow.astro';
import photo from '../assets/denise-chua.jpeg';
import { site } from '../data/site';

const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---
<BaseLayout title={site.name} description={page.data.description} jsonLd rail>
  <section class="hero" aria-labelledby="hero-name">
    <span class="frame">
      <span class="frame__c frame__c--tl"></span><span class="frame__c frame__c--tr"></span>
      <span class="frame__c frame__c--bl"></span><span class="frame__c frame__c--br"></span>
      <Image
        src={photo}
        alt="Portrait of Denise Mae Chua"
        class="hero__photo"
        widths={[176, 352]}
        sizes="176px"
        loading="eager"
        fetchpriority="high"
      />
      <span class="frame__label">SWALLOWING · HKU</span>
    </span>
    <div class="hero__text">
      <h1 id="hero-name">{site.name}</h1>
      <p class="hero__title">{site.jobTitle}</p>
      <p class="hero__affil">
        {site.role}, <a href={site.lab.url}>{site.lab.name}</a><br />{site.affiliation.name}
      </p>
      <div class="hero__actions">
        <a class="button" href={site.cv}><Icon name="download" /> Download CV</a>
        <SocialLinks />
      </div>
    </div>
    <HeroSwallow />
  </section>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
