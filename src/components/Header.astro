---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">{site.shortName}<span class="site-header__suffix">, PhD</span></a>
    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button type="button" class="theme-toggle" aria-label="Dark mode" aria-pressed="false">
      <Icon name="moon" />
      <Icon name="sun" />
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const system = matchMedia('(prefers-color-scheme: dark)');

  function setTheme(theme: 'light' | 'dark', remember: boolean) {
    root.dataset.theme = theme;
    button.setAttribute('aria-pressed', String(theme === 'dark'));
    const bg = getComputedStyle(document.body).backgroundColor;
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', bg));
    if (remember) try { localStorage.setItem('theme', theme); } catch {}
  }

  setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
  button.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true));
  system.addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (!saved) setTheme(e.matches ? 'dark' : 'light', false);
  });
</script>
