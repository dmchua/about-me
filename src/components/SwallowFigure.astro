---
// Research page background: an original line drawing of a person in side view (facing left),
// head to stomach. As the page scrolls, a bolus travels the swallowing path: over the
// tongue, down the pharynx, through the esophagus, and into the stomach.
// Decorative only (aria-hidden).

// The bolus path, through the middle of the oral cavity, pharynx, and esophagus.
const route =
  'M 128 219 C 150 214 180 212 200 215 C 218 219 228 231 234 251 C 238 271 240 300 241 330 ' +
  'C 242 345 242 358 243 365 C 245 450 247 560 254 650 C 258 720 261 770 263 805 C 262 832 248 852 222 852';

// Vertebral bodies: the neck curves forward a little, the upper back curves back.
const cervical = Array.from({ length: 6 }, (_, i) => {
  const y = 252 + i * 32;
  return { x: 270 - 6 * Math.sin((Math.PI * i) / 5), y };
});
const thoracic = Array.from({ length: 9 }, (_, i) => {
  const y = 448 + i * 34;
  return { x: 274 + (y - 448) * 0.055, y };
});
const ribs = Array.from({ length: 6 }, (_, i) => 520 + i * 44);
const rings = Array.from({ length: 14 }, (_, i) => 368 + i * 16);
---
<div class="figure-bg" aria-hidden="true">
  <svg viewBox="60 40 360 860" preserveAspectRatio="xMidYMin meet">
    <g class="fig-outline">
      <!-- back of the head, over the crown, then the face, neck, and chest -->
      <path d="M 306 262 C 336 230 350 160 318 105 C 292 62 240 44 196 50 C 150 56 120 90 114 132
        C 112 142 108 148 106 154 C 110 160 114 164 113 170 C 106 182 94 194 90 202
        C 92 208 100 210 106 210 C 104 216 100 220 102 224 C 106 228 108 230 104 232
        C 100 236 100 242 106 246 C 110 250 108 254 106 258 C 102 268 104 278 116 284
        C 140 292 162 292 176 296 C 186 320 190 360 190 400 C 190 440 186 470 176 500
        C 150 560 128 620 126 700 C 125 780 132 860 140 960" />
      <!-- nape, upper back -->
      <path d="M 306 262 C 296 300 296 340 300 380 C 304 420 322 446 350 466 C 372 520 382 640 380 760 C 379 840 374 900 370 960" />
      <!-- ear -->
      <path class="fig-faint" d="M 268 166 C 284 162 292 182 284 198 C 280 206 271 205 268 196" />
    </g>

    <g class="fig-bone">
      <!-- jaw -->
      <path d="M 116 268 C 140 276 180 276 204 268 C 214 258 220 236 222 214" />
      <!-- hard palate, soft palate, uvula -->
      <path d="M 118 208 C 150 203 180 202 198 205 C 212 207 222 215 226 227 C 228 234 224 238 221 234" />
      <!-- hyoid -->
      <path d="M 194 297 L 216 293" />
      {cervical.map((v) => <rect x={v.x - 12} y={v.y} width="24" height="24" rx="6" />)}
      {thoracic.map((v) => <rect x={v.x - 13} y={v.y} width="26" height="26" rx="6" />)}
      {ribs.map((y) => <path class="fig-faint" d={`M 300 ${y} C 250 ${y + 4} 180 ${y + 28} 140 ${y + 74}`} />)}
    </g>

    <g class="fig-soft">
      <!-- tongue -->
      <path d="M 120 236 C 135 222 165 217 192 222 C 214 227 224 246 222 270 C 219 288 211 300 204 306" />
      <!-- back wall of the pharynx -->
      <path d="M 240 196 C 246 240 250 300 251 362" />
      <!-- epiglottis -->
      <path d="M 224 302 C 221 287 226 273 237 266" />
      <!-- larynx -->
      <path d="M 205 318 C 212 312 222 314 226 322 L 228 350 C 220 356 210 356 206 350 Z" />
      <!-- trachea, with faint rings -->
      <path d="M 207 356 C 209 440 212 520 218 600" />
      <path d="M 227 356 C 229 440 231 520 236 600" />
      {rings.map((y) => <path class="fig-faint" d={`M ${208 + (y - 356) * 0.045} ${y} L ${228 + (y - 356) * 0.035} ${y}`} />)}
      <!-- esophagus: two walls -->
      <path d="M 237 362 C 239 450 241 560 248 650 C 252 720 255 770 257 805" />
      <path d="M 249 362 C 251 450 253 560 260 650 C 264 720 267 770 269 806" />
      <!-- diaphragm -->
      <path d="M 120 800 C 170 740 300 736 380 790" />
      <!-- stomach -->
      <path d="M 257 805 C 258 835 246 872 208 878 C 168 884 146 856 154 826 C 162 798 198 790 228 798 C 244 802 262 806 269 806" />
    </g>

    <path class="fig-track" d={route} />
    <path class="fig-coat" d={route} />
    <ellipse class="fig-bolus" cx="128" cy="219" rx="8" ry="6" />
    <text class="fig-phase" x="112" y="200">ORAL</text>
  </svg>
</div>

<script>
  const fig = document.querySelector<HTMLElement>('.figure-bg');
  if (fig) {
    const track = fig.querySelector<SVGPathElement>('.fig-track')!;
    const coat = fig.querySelector<SVGPathElement>('.fig-coat')!;
    const bolus = fig.querySelector<SVGEllipseElement>('.fig-bolus')!;
    const phase = fig.querySelector<SVGTextElement>('.fig-phase')!;
    const len = track.getTotalLength();
    coat.style.strokeDasharray = `${len} ${len}`;
    let target = 0, pos = 0, raf = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      return max > 40 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    };
    const draw = () => {
      const p = track.getPointAtLength(pos * len);
      const down = p.y > 240 && p.y < 805;
      bolus.setAttribute('cx', String(p.x));
      bolus.setAttribute('cy', String(p.y));
      bolus.setAttribute('rx', String(down ? 6 : 8));
      bolus.setAttribute('ry', String(down ? 8 : 6));
      coat.style.strokeDashoffset = String(len * (1 - pos));
      phase.textContent = p.y < 236 ? 'ORAL' : p.y < 362 ? 'PHARYNGEAL' : p.y < 806 ? 'ESOPHAGEAL' : 'STOMACH';
      phase.setAttribute('x', String(p.x - 18));
      phase.setAttribute('y', String(p.y + 4));
    };
    // Ease toward the scroll position so the bolus glides.
    const tick = () => {
      pos = reduce ? target : pos + (target - pos) * 0.15;
      draw();
      raf = Math.abs(target - pos) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener('scroll', () => { target = progress(); if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
    target = pos = progress();
    draw();
  }
</script>

<style is:global>
  .figure-bg {
    position: fixed; z-index: 0; top: 0; bottom: 0; pointer-events: none;
    right: max(-200px, calc((100vw - 52rem) / 2 - 364px)); width: min(88vw, 520px);
    -webkit-mask-image: linear-gradient(#000 75%, transparent); mask-image: linear-gradient(#000 75%, transparent);
    opacity: .8;
  }
  .figure-bg svg { width: 100%; height: 100%; display: block; }
  body:has(.figure-bg) .site-header, body:has(.figure-bg) main, body:has(.figure-bg) .site-footer { position: relative; z-index: 1; }

  .fig-outline path, .fig-bone path, .fig-soft path {
    fill: none; stroke: var(--muted); stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke;
  }
  .fig-outline path { stroke-width: 1.6; opacity: .42; }
  .fig-bone path { stroke-width: 1.4; opacity: .38; }
  .fig-bone rect { fill: none; stroke: var(--muted); stroke-width: 1.2; opacity: .3; vector-effect: non-scaling-stroke; }
  .fig-soft path { stroke-width: 1.2; opacity: .34; }
  .figure-bg .fig-faint { opacity: .18; }
  .fig-track { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 2 5; opacity: .35; vector-effect: non-scaling-stroke; }
  .fig-coat { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; opacity: .22; }
  .fig-bolus { fill: var(--accent); }
  .fig-phase { font: 500 10px/1 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: 2px; fill: var(--accent); text-anchor: end; opacity: .85; }

  /* Phones: the figure sits further right and fainter, so the text stays easy to read. */
  @media (max-width: 767px) {
    .figure-bg { right: -38vw; width: 100vw; opacity: .55; }
    .fig-phase { display: none; }
  }
  @media print { .figure-bg { display: none; } }
</style>
