---
// Preview-only: flip between the candidate redesigns. Remove once one is chosen.
import { designs } from '../data/site';
---
<div class="design-switcher" role="group" aria-label="Preview design">
  {designs.map((d, i) => (
    <button type="button" data-design-choice={d.id}>
      <span class="design-switcher__key">{i + 1}</span> {d.label}
    </button>
  ))}
</div>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-design-choice]');
  const sync = () =>
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.designChoice === root.dataset.design)));
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.design = b.dataset.designChoice!;
      try { localStorage.setItem('design', root.dataset.design); } catch {}
      sync();
      dispatchEvent(new Event('resize')); // let the swallow rail re-measure
    }),
  );
  sync();
</script>

<style is:global>
  body { padding-bottom: 5rem; }
  .design-switcher {
    position: fixed; left: 50%; bottom: max(.75rem, env(safe-area-inset-bottom)); transform: translateX(-50%);
    z-index: 100; display: flex; gap: .25rem; padding: .3rem;
    background: rgba(20, 20, 24, .9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-radius: 999px; box-shadow: 0 6px 24px rgba(0, 0, 0, .3);
    font: 600 .82rem/1 ui-sans-serif, -apple-system, 'Segoe UI', sans-serif; white-space: nowrap;
  }
  .design-switcher button { all: unset; cursor: pointer; color: #d6d6dc; padding: .65rem .75rem; border-radius: 999px; }
  @media (max-width: 400px) { .design-switcher { font-size: .76rem; } .design-switcher button { padding: .6rem .55rem; } }
  .design-switcher button[aria-pressed='true'] { background: #fff; color: #111; }
  .design-switcher button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .design-switcher__key { opacity: .55; margin-right: .15rem; }
</style>
