  orcid: '<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path fill="currentColor" d="M8 10h1.6v7H8zM8.8 6.9a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM11.2 10h2.6c2.3 0 3.6 1.5 3.6 3.5S16 17 13.8 17h-2.6zm1.6 1.4v4.2h.9c1.4 0 2.1-.9 2.1-2.1s-.7-2.1-2.1-2.1z"/>',
