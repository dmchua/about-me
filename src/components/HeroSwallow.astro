---
// A looping videofluoroscopy-style swallow for the home page hero: the bolus crosses the
// mouth, tips over the back of the tongue and drops down the pharynx and esophagus, with
// a peristaltic squeeze chasing it. Decorative only; only some designs show it.
const d = 'M 44 80 H 168 A 62 62 0 0 1 230 142 V 290';
---
<figure class="hero-swallow" aria-hidden="true">
  <svg viewBox="0 0 300 320" preserveAspectRatio="xMidYMid meet">
    <defs>
      <radialGradient id="hs-glow" cx="50%" cy="45%" r="60%">
        <stop offset="0" style="stop-color: var(--hs-screen-hi)" />
        <stop offset="1" style="stop-color: var(--hs-screen-hi); stop-opacity: 0" />
      </radialGradient>
      <filter id="hs-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
      <filter id="hs-bloom" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="3" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      <pattern id="hs-scan" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="4" height="1" fill="#fff" opacity=".05" /></pattern>
    </defs>
    <rect x="-40" y="-40" width="380" height="400" fill="url(#hs-glow)" />
    <path d={d} fill="none" style="stroke: var(--hs-tube)" stroke-width="46" stroke-linecap="round" filter="url(#hs-soft)" opacity=".85" />
    <path d={d} fill="none" style="stroke: var(--hs-track)" stroke-width="1.5" stroke-dasharray="2 6" />

    <!-- peristaltic squeeze: a dark band that chases the bolus -->
    <ellipse rx="7" ry="30" style="fill: var(--hs-wave)" filter="url(#hs-soft)" opacity="0">
      <animateMotion dur="4.2s" begin=".35s" repeatCount="indefinite" rotate="auto" path={d}
        keyPoints="0;0;1;1" keyTimes="0;.2;.86;1" calcMode="spline" keySplines="0 0 1 1;.5 0 .3 1;0 0 1 1" />
      <animate attributeName="opacity" dur="4.2s" begin=".35s" repeatCount="indefinite" values="0;0;.9;.9;0" keyTimes="0;.22;.3;.8;1" />
    </ellipse>

    <!-- the bolus, stretching as it accelerates down -->
    <ellipse rx="16" ry="12" style="fill: var(--hs-bolus)" filter="url(#hs-bloom)">
      <animateMotion dur="4.2s" repeatCount="indefinite" rotate="auto" path={d}
        keyPoints="0;0;1;1" keyTimes="0;.2;.86;1" calcMode="spline" keySplines="0 0 1 1;.5 0 .3 1;0 0 1 1" />
      <animate attributeName="rx" dur="4.2s" repeatCount="indefinite" values="16;16;26;20;12;12" keyTimes="0;.2;.45;.62;.86;1" />
      <animate attributeName="ry" dur="4.2s" repeatCount="indefinite" values="12;12;9;10;7;7" keyTimes="0;.2;.45;.62;.86;1" />
      <animate attributeName="opacity" dur="4.2s" repeatCount="indefinite" values="0;1;1;1;0" keyTimes="0;.08;.8;.88;1" />
    </ellipse>

    <g class="hero-swallow__labels" font-family="IBM Plex Mono, ui-monospace, monospace" font-size="10" letter-spacing="2.4">
      <text x="44" y="52">ORAL</text>
      <text x="196" y="160" text-anchor="end">PHARYNGEAL</text>
      <text x="196" y="256" text-anchor="end">ESOPHAGEAL</text>
    </g>
  </svg>
</figure>

<script>
  // Respect reduced motion: freeze the loop on its first frame.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.hero-swallow svg').forEach((s) => { s.pauseAnimations(); s.setCurrentTime(1.6); });
  }
</script>
