---
// An original, simplified lateral (side-view) videofluoroscopy drawing of the head and neck,
// facing left. The bolus follows `.xr-route`: across the tongue, over the back of the
// tongue, down the pharynx, through the upper esophageal sphincter and down the esophagus.
// A controller script (XrayController) moves it; colours come from the active "look".
interface Props {
  mode: 'list' | 'loop' | 'head' | 'pinned' | 'tap';
  labels?: boolean;
  class?: string;
}
const { mode, labels = false, class: cls } = Astro.props;
const uid = `xr-${Math.random().toString(36).slice(2, 8)}`;
const route = 'M 112 214 C 140 206 180 198 206 204 C 224 210 230 226 234 250 C 236 280 238 310 241 330 C 244 400 246 480 248 552';
const vertebrae = [230, 268, 306, 344, 382, 420, 458, 496];
const anatomy = [
  { name: 'Tongue', x: 160, y: 224, ly: 150 },
  { name: 'Soft palate', x: 214, y: 196, ly: 190 },
  { name: 'Epiglottis', x: 234, y: 268, ly: 240 },
  { name: 'Hyoid', x: 200, y: 290, ly: 285 },
  { name: 'Larynx', x: 206, y: 340, ly: 330 },
  { name: 'UES', x: 242, y: 345, ly: 375 },
  { name: 'Esophagus', x: 247, y: 460, ly: 460 },
];
---
<figure class:list={['xr', cls]} data-mode={mode} aria-hidden="true">
  <svg viewBox={labels ? '30 10 500 560' : '50 10 330 560'} preserveAspectRatio="xMidYMid meet">
    <defs>
      <filter id={`${uid}-soft`} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="6" /></filter>
      <filter id={`${uid}-bone`} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="2.2" /></filter>
      <filter id={`${uid}-glow`} x="-200%" y="-200%" width="500%" height="500%">
        <feGaussianBlur stdDeviation="4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <radialGradient id={`${uid}-screen`} cx="45%" cy="40%" r="70%">
        <stop offset="0" class="xr-screen-hi" /><stop offset="1" class="xr-screen-lo" />
      </radialGradient>
    </defs>

    <rect class="xr-screen" x="0" y="0" width="560" height="580" fill={`url(#${uid}-screen)`} />

    <g class="xr-body">
      <!-- soft tissue: head and neck in profile -->
      <path class="xr-tissue" filter={`url(#${uid}-soft)`}
        d="M 335 140 C 340 80 300 30 235 22 C 170 15 120 45 108 95 C 103 112 100 125 96 138 C 90 150 72 165 70 178 C 69 186 82 190 92 192 C 90 200 92 206 96 210 C 90 216 92 224 97 230 C 92 240 94 252 100 262 C 108 274 140 280 172 284 C 182 300 188 330 190 370 C 192 420 186 470 170 560 L 400 560 L 400 520 C 360 500 320 480 308 440 C 300 400 300 330 305 280 C 312 240 330 200 335 140 Z" />
      <!-- bone -->
      <g class="xr-bone" filter={`url(#${uid}-bone)`}>
        <path class="xr-line" d="M 300 150 C 315 90 285 45 235 38 C 180 32 135 58 122 100 C 118 115 117 125 118 135" stroke-width="7" />
        <path class="xr-line" d="M 104 190 L 196 184" stroke-width="7" />
        <path class="xr-line" d="M 104 258 C 120 268 170 266 205 252 C 214 240 216 215 214 195" stroke-width="9" />
        <path class="xr-line" d="M 186 292 L 214 288" stroke-width="7" />
        <rect x="258" y="186" width="30" height="34" rx="9" />
        {vertebrae.map((y) => <rect x="262" y={y} width="40" height="30" rx="8" />)}
      </g>
      <!-- tongue, soft palate, epiglottis, thyroid cartilage -->
      <path class="xr-organ" filter={`url(#${uid}-bone)`} d="M 106 214 C 120 196 170 186 205 200 C 222 210 224 238 214 262 C 190 262 140 252 106 236 Z" />
      <path class="xr-organ-line" filter={`url(#${uid}-bone)`} d="M 196 184 C 212 186 222 196 226 214" stroke-width="8" />
      <path class="xr-organ-line" filter={`url(#${uid}-bone)`} d="M 222 292 C 224 276 230 266 238 262" stroke-width="5" />
      <path class="xr-organ" filter={`url(#${uid}-bone)`} d="M 194 318 L 214 316 L 216 352 L 198 356 Z" />
      <!-- air spaces: pharynx, trachea; the collapsed esophagus -->
      <g class="xr-air" filter={`url(#${uid}-soft)`}>
        <path d="M 232 186 C 238 230 238 280 240 330" stroke-width="18" />
        <path d="M 205 360 C 206 400 206 470 204 560" stroke-width="16" />
      </g>
      <path class="xr-esoph" filter={`url(#${uid}-bone)`} d="M 242 330 C 244 400 246 480 248 560" stroke-width="9" />
    </g>

    <!-- barium coating left behind the bolus, then the bolus -->
    <path class="xr-route" d={route} />
    <path class="xr-coat" d={route} />
    <ellipse class="xr-bolus" cx="112" cy="214" rx="13" ry="9" filter={`url(#${uid}-glow)`} />

    {labels && (
      <g class="xr-labels">
        {anatomy.map((a) => (
          <g class="xr-label" data-x={a.x} data-y={a.y}>
            <polyline points={`${a.x},${a.y} 330,${a.ly} 410,${a.ly}`} />
            <circle cx={a.x} cy={a.y} r="3" />
            <text x="416" y={a.ly + 4}>{a.name}</text>
          </g>
        ))}
      </g>
    )}
    <text class="xr-phase" x={labels ? 40 : 60} y="34">ORAL</text>
  </svg>
</figure>
