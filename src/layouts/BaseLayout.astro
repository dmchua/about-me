---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, links } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string; // page name, e.g. "Research". Use the site name for the home page.
  description: string;
  jsonLd?: boolean; // include Person structured data (home page)
  noindex?: boolean;
}
const { title, description, jsonLd = false, noindex = false } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Denise Mae Chua',
  honorificSuffix: 'PhD',
  givenName: site.givenName,
  familyName: site.familyName,
  jobTitle: site.jobTitle,
  email: `mailto:${site.email}`,
  url: new URL('/', Astro.site).href,
  image: new URL('/images/denise-chua.jpg', Astro.site).href,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: site.affiliation.name,
    url: site.affiliation.url,
    department: { '@type': 'Organization', name: site.lab.name, url: site.lab.url },
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'The University of Hong Kong' },
    { '@type': 'CollegeOrUniversity', name: 'University of the Philippines Manila' },
  ],
  knowsAbout: ['Speech-language pathology', 'Dysphagia', 'Swallowing', 'fNIRS'],
  sameAs: links.filter((l) => l.icon !== 'email').map((l) => l.url),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121615" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={jsonLd ? 'profile' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portrait of Denise Mae Chua, PhD" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@denisechuaSLP" />
    <meta name="twitter:creator" content="@denisechuaSLP" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
